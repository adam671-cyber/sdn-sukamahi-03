<%- include('partials/header') %>

<div class="max-w-7xl mx-auto py-8 px-4">
    <h2 class="text-3xl font-bold text-gray-800 mb-6">Ruang Belajar & Materi Pembelajaran</h2>

    <div class="bg-white p-6 rounded-lg shadow-md mb-8">
        <h3 class="text-xl font-semibold mb-4 text-blue-800">Unggah Materi Baru (PDF, Word, Excel, PPT)</h3>
        <form action="/upload-materi" method="POST" enctype="multipart/form-data" class="space-y-4">
            <div>
                <label class="block font-medium mb-1">Judul Materi / Tugas</label>
                <input type="text" name="judul" required class="w-full border p-2 rounded focus:ring-2 focus:ring-blue-500">
            </div>
            <div>
                <label class="block font-medium mb-1">Mata Pelajaran / Kelas</label>
                <input type="text" name="kategori" placeholder="Contoh: Matematika - Kelas 4" required class="w-full border p-2 rounded focus:ring-2 focus:ring-blue-500">
            </div>
            <div>
                <label class="block font-medium mb-1">Pilih File (.pdf, .docx, .xlsx, .pptx)</label>
                <input type="file" name="fileMateri" required class="w-full border p-2 rounded bg-gray-50">
            </div>
            <button type="submit" class="bg-blue-600 text-white px-6 py-2 rounded hover:bg-blue-700 font-semibold">Unggah File</button>
        </form>
    </div>

    <div class="bg-white p-6 rounded-lg shadow-md">
        <h3 class="text-xl font-semibold mb-4 text-gray-800">Daftar Materi & Modul Tersedia</h3>
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="bg-gray-100 border-b">
                        <th class="p-3">Judul Materi</th>
                        <th class="p-3">Kategori</th>
                        <th class="p-3">Aksi</th>
                    </tr>
                </thead>
                <tbody>
                    <% materis.forEach(materi => { %>
                        <tr class="border-b hover:bg-gray-50">
                            <td class="p-3 font-medium"><%= materi.title %></td>
                            <td class="p-3 text-gray-600"><%= materi.category %></td>
                            <td class="p-3">
                                <a href="<%= materi.fileUrl %>" download class="bg-green-600 text-white px-4 py-1 rounded text-sm hover:bg-green-700">Unduh File</a>
                            </td>
                        </tr>
                    <% }); %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<%- include('partials/footer') %>